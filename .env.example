# MySQL connection settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tripdeck

# Backend API endpoint (leave empty to use relative path via proxy)
# Example: http://192.168.1.100
VITE_API_DOMAIN=
VITE_API_PORT=3001

# Public-facing port used when the frontend calls VITE_API_DOMAIN directly,
# e.g. when a reverse proxy maps VITE_API_DOMAIN to a different external
# port than the backend's internal VITE_API_PORT; leave empty to reuse
# VITE_API_PORT
VITE_API_PUBLIC_PORT=

# Origin(s) allowed to make cross-origin requests to this API, comma-
# separated (needed when VITE_API_DOMAIN points the frontend directly at
# this API instead of going through the frontend's nginx same-origin proxy);
# leave empty to disable CORS headers entirely
# Example: http://tripdeck.example.com
CORS_ORIGIN=

# OpenWeatherMap API key (primary weather source, supports up to 5 days ahead)
# Get a free key at https://openweathermap.org/api
VITE_OWM_API_KEY=

# Visual Crossing API key (extended weather source, supports up to 15 days ahead)
# Used as fallback when OWM is unavailable or the date exceeds OWM's 5-day range
# Get a free key at https://www.visualcrossing.com/weather-api
# Leave both keys empty to disable the weather feature
VITE_VC_API_KEY=

# Frontend port
FRONTEND_PORT=3000

# Automatic full-system backup (all trips + checklist template + images)
# - AUTO_BACKUP_ENABLED: set to false to disable the periodic checker entirely
# - BACKUPS_HOST_DIR: host directory bind-mounted into the backend container's
#   backup output; default (`./.backups`) is relative to wherever
#   docker-compose.yml is run from -- override with an absolute path when
#   that directory isn't stable (e.g. deployed via Portainer, which clones
#   the stack into its own internal working directory)
# - AUTO_BACKUP_INTERVAL_DAYS: how old the newest automatic backup must be before a new one is due
# - AUTO_BACKUP_CHECK_INTERVAL_HOURS: how often to re-check the above (the server never backs up immediately on startup)
# - AUTO_BACKUP_RETENTION_COUNT: how many automatic backup files to keep
AUTO_BACKUP_ENABLED=true
BACKUPS_HOST_DIR=./.backups
AUTO_BACKUP_INTERVAL_DAYS=15
AUTO_BACKUP_CHECK_INTERVAL_HOURS=24
AUTO_BACKUP_RETENTION_COUNT=6

# Docker uploads volume host path
# - UPLOADS_HOST_DIR: host directory bind-mounted into the backend container's
#   uploaded trip images; default (`./.uploads`) is relative to wherever
#   docker-compose.yml is run from -- override with an absolute path when
#   that directory isn't stable (e.g. deployed via Portainer, which clones
#   the stack into its own internal working directory)
UPLOADS_HOST_DIR=./.uploads

# Application logging (written to a file only; nothing is printed to the
# console)
# - LOG_LEVEL: minimum severity written (debug|info|warn|error)
# - LOGS_HOST_DIR: host directory bind-mounted into the backend container's
#   log output; default (`./.logs`) is relative to wherever docker-compose.yml
#   is run from -- override with an absolute path when that directory isn't
#   stable (e.g. deployed via Portainer, which clones the stack into its own
#   internal working directory)
# - LOG_DIR: directory log files are written to; leave empty to use the
#   built-in default (`server/logs` outside Docker, `/app/logs` inside the
#   container -- the latter is what LOGS_HOST_DIR above is bind-mounted onto)
# - LOG_FILENAME: base filename for the active log file; once it passes
#   LOG_MAX_SIZE_MB it's renamed "<name>.1.<ext>", the previous "<name>.1.<ext>"
#   becomes "<name>.2.<ext>", and so on -- a file is never overwritten
# - LOG_MAX_SIZE_MB: rotate once the active file reaches this size
# - LOG_MAX_FILES: how many rotated (historical) files to keep; 0 = unlimited
LOG_LEVEL=info
LOGS_HOST_DIR=./.logs
LOG_DIR=
LOG_FILENAME=tripdeck.log
LOG_MAX_SIZE_MB=10
LOG_MAX_FILES=5
