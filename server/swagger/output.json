    "/api/health": {
      "get": {
        "tags": ["System"],
        "summary": "Health check",
        "description": "",
        "responses": {
          "200": {
            "description": "Server is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time",
                      "example": "2024-05-10T08:00:00.000Z"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
