# Dependencies
node_modules/

# Build output
client/dist/
client/dist-ssr/
server/dist/

# Test coverage reports
client/coverage/
client/test-results.json
server/coverage/
server/test-results.json

# TypeScript
*.tsbuildinfo

# Vite
.vite/

# Logs
# (not a blanket "logs/" rule: server/logs/ needs its .gitkeep tracked, see
# below, and a directory-level ignore would prevent that negation from
# taking effect)
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables
.env
.env.local
.env.*.local
.env.production

# Docker export
docker/

# OS
.DS_Store
Thumbs.db

# Claude Code
.claude/

# Uploaded images (keep directory structure, ignore actual files)
server/uploads/*
!server/uploads/.gitkeep

# Automatic backup files (keep directory structure, ignore actual files)
server/backups/*
!server/backups/.gitkeep

# Log files (keep directory structure, ignore actual files)
server/logs/*
!server/logs/.gitkeep

# Docker uploads volume
.uploads/

# Docker backups volume
.backups/

# Docker logs volume
.logs/

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
